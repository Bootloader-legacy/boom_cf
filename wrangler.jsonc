{
  "name": "boom-cf",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",

  "durable_objects": {
    "bindings": [
      {
        "name": "BOOM_ROOMS",
        "class_name": "BoomRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoomRoom"]
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
